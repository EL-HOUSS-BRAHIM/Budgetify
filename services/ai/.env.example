# Port the service listens on.
PORT=8787

# Supabase project the service validates caller JWTs against.
# The service uses the caller's own JWT for every database write so that RLS
# applies identically to human and assistant actions. It must NEVER hold the
# service-role key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# LLM provider. Set when the `assistant` module is built; unused before then.
# The service must still boot with these empty.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
