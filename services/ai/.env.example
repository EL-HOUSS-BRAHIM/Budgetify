# Copy this file to services/ai/.env and replace the REPLACE_ME values.
PORT=8787

# Find these values in Supabase Dashboard > Connect.
SUPABASE_URL=https://hnlieepsxoqeebkreugt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Never put the database password, Supabase personal access token,
# secret key, or service-role key in this file. The API forwards each signed-in
# user's access token so Postgres Row Level Security remains enforced.

# Optional later: leave blank while starting the deterministic assistant.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
